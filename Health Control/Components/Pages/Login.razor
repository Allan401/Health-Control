@page "/login"
@rendermode InteractiveServer
@using Health_Control.Services

@inject UsuarioRepositorio Repositorio

@code {
    private string email = "";
    private string senha = "";
    private string mensagem = "";

    private void Entrar()
    {
        var usuarioLogado = Repositorio.BuscarPorEmail(email.Trim());

        if (usuarioLogado != null && BCrypt.Net.BCrypt.Verify(senha, usuarioLogado.SenhaHash))
        {
            mensagem = $"Seja bem vindo {usuarioLogado.Nome}!";
        }
        else
        {
            mensagem = "Login incorreto";
        }
    }
}


<h1>HEALTH CONTROL</h1>

<p>Por favor, digite seu e-mail de login para continuar</p>

<input type="text" @bind="email" />

<p>Por favoor, digite sua senha</p>

<input type="password" @bind="senha" />

<button @onclick="Entrar">Entrar</button>

<p>@mensagem</p>

